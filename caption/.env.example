# Copy to .env and fill in your keys. Do NOT commit real keys.

# OpenAI backend (default)
OPENAI_API_KEY=your_openai_api_key

# Optional Gemini backend
GEMINI_API_KEY=your_gemini_api_key

# Optional model overrides
OPENAI_CAPTION_MODEL=gpt-4o-mini
OPENAI_MERGE_MODEL=gpt-5-nano
GEMINI_CAPTION_MODEL=gemini-2.5-flash
GEMINI_MERGE_MODEL=gemini-2.5-flash-lite
